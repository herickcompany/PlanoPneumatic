NODE_ENV=production
PORT=<railway-provided-port>
HOST=0.0.0.0
FRONTEND_ORIGIN=https://planopneumatic-production.up.railway.app
API_PUBLIC_URL=https://URL-PUBLICA-DA-API
DATABASE_URL=<railway-postgres-connection>
# So usados se a tabela de usuarios estiver vazia (primeira subida); depois podem ser removidos.
SEED_ADMIN_EMAIL=<production-admin-email>
SEED_ADMIN_PASSWORD=<strong-secret>
API_UPSTREAM_URL=https://planopneumaticapi-production.up.railway.app
SESSION_DURATION_DAYS=1

# Integracao Omie (opcional): chaves em Omie > Configuracoes > Integracoes > Aplicativos (app_key / app_secret)
OMIE_APP_KEY=
OMIE_APP_SECRET=
OMIE_SYNC_INTERVAL_HOURS=24

# Opcional: habilita GET /api/metrics (Authorization: Bearer <token>)
METRICS_TOKEN=
